generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model CmsCollection {
  key       String   @id @db.VarChar(64)
  payload   Json
  revision  Int      @default(1)
  updatedAt DateTime @updatedAt

  @@map("cms_collections")
}

model CmsRecord {
  id             String   @id @default(cuid()) @db.VarChar(30)
  collectionKey  String   @db.VarChar(64)
  locale         String   @default("all") @db.VarChar(8)
  itemKey        String   @db.VarChar(191)
  position       Int
  payload        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([collectionKey, locale, itemKey])
  @@index([collectionKey, locale, position, id])
  @@map("cms_records")
}

model MediaAsset {
  id           String   @id @default(cuid()) @db.VarChar(30)
  publicId     String?  @unique @db.VarChar(191)
  url          String   @db.Text
  secureUrl    String   @db.Text
  provider     String   @default("cloudinary") @db.VarChar(16)
  resourceType String   @db.VarChar(16)
  format       String?  @db.VarChar(32)
  bytes        Int      @default(0)
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())

  @@index([resourceType, createdAt])
  @@index([createdAt, id])
  @@map("media_assets")
}
