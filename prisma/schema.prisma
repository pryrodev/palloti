generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model CmsCollection {
  key       String   @id @db.VarChar(64)
  payload   Json
  revision  Int      @default(1)
  updatedAt DateTime @updatedAt

  @@map("cms_collections")
}

model CmsRecord {
  id            String   @id @default(cuid()) @db.VarChar(30)
  collectionKey String   @db.VarChar(64)
  locale        String   @default("all") @db.VarChar(8)
  itemKey       String   @db.VarChar(191)
  position      Int
  payload       Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([collectionKey, locale, itemKey])
  @@index([collectionKey, locale, position, id])
  @@map("cms_records")
}

model MediaAsset {
  id           String   @id @default(cuid()) @db.VarChar(30)
  publicId     String?  @unique @db.VarChar(191)
  name         String?  @db.VarChar(255)
  url          String   @db.Text
  secureUrl    String   @db.Text
  provider     String   @default("cloudinary") @db.VarChar(16)
  resourceType String   @db.VarChar(16)
  format       String?  @db.VarChar(32)
  bytes        Int      @default(0)
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())

  @@index([resourceType, createdAt])
  @@index([createdAt, id])
  @@map("media_assets")
}

model User {
  id            String    @id @db.VarChar(191)
  name          String    @db.VarChar(191)
  email         String    @unique @db.VarChar(191)
  emailVerified Boolean   @default(false)
  image         String?   @db.Text
  role          String    @default("user") @db.VarChar(191)
  banned        Boolean?  @default(false)
  banReason     String?   @db.Text
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id             String   @id @db.VarChar(191)
  expiresAt      DateTime
  token          String   @unique @db.VarChar(191)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?  @db.VarChar(191)
  userAgent      String?  @db.Text
  userId         String   @db.VarChar(191)
  impersonatedBy String?  @db.VarChar(191)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @db.VarChar(191)
  accountId             String    @db.VarChar(191)
  providerId            String    @db.VarChar(191)
  userId                String    @db.VarChar(191)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.VarChar(191)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @db.VarChar(191)
  identifier String   @db.VarChar(191)
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
